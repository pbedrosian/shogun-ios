{
  "name": "shogun-backend-tools",
  "private": true,
  "description": "Local Supabase development tooling; not an iOS runtime dependency",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/backend/dev.mjs",
    "backend:docs": "node scripts/backend/docs.mjs",
    "backend:doctor": "node scripts/backend/local.mjs doctor",
    "backend:start": "supabase --workdir backend start",
    "backend:stop": "supabase --workdir backend stop",
    "backend:status": "supabase --workdir backend status",
    "backend:reset": "supabase --workdir backend db reset --local",
    "backend:fixtures": "node scripts/backend/local.mjs fixtures",
    "backend:smoke": "node scripts/backend/local.mjs smoke",
    "backend:test": "node --test scripts/backend/*.test.mjs",
    "backend:test:db": "supabase --workdir backend test db --local",
    "backend:test:api": "node scripts/backend/permissions.mjs",
    "ios:configure": "node scripts/backend/configure-ios.mjs",
    "backend:test:deletion": "node scripts/backend/delete-account-api.mjs",
    "backend:demo": "node scripts/backend/demo-account.mjs",
    "backend:test:collection": "node scripts/backend/collection-api.mjs",
    "backend:test:movie-add": "node scripts/backend/movie-add-api.mjs",
    "backend:test:catalog": "node scripts/backend/catalog-api.mjs"
  },
  "devDependencies": {
    "supabase": "2.122.0",
    "swagger-ui-dist": "5.34.0"
  }
}
