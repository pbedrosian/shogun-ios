# OPTIONAL server-only SMTP setup. Used only after opting in via docs/EMAIL.md.
# Copy/merge into ignored backend/.env; never put these values in iOS configuration.
# Resend example: its API key is the SMTP password. Leave empty in this template.
SHOGUN_SMTP_PASSWORD=
# Replace this example with a reachable Mac LAN Auth URL for local phone testing.
SHOGUN_AUTH_EXTERNAL_URL=http://192.168.1.20:54321/auth/v1
