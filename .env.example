# Reference values for future client integration; the current iOS demo does not read this file.
# Copy to .env.local if needed. No hosted credentials are required for SHO-25.
SUPABASE_URL=http://127.0.0.1:54321
# Copy ONLY the local publishable/anon key from npm run backend:status.
SUPABASE_PUBLISHABLE_KEY=
# Never place a secret/service-role key in client configuration.
