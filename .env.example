# Client reference only; the iOS app reads build-time xcconfig, not this dotenv file.
# For server SMTP configuration use backend/.env.example and docs/EMAIL.md instead.
SUPABASE_URL=http://127.0.0.1:54321
# Copy ONLY the local publishable/anon key from npm run backend:status.
SUPABASE_PUBLISHABLE_KEY=
# Never place a secret/service-role key in client configuration.
